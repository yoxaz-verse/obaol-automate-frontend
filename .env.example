# NEXT_PUBLIC_OBAOL_API_BASE_URL=http://localhost:5002
# Public iOS update manifest. Leave the App Store URL blank until the listing is live.
IOS_LATEST_VERSION=1.0.1
IOS_MINIMUM_VERSION=1.0.0
IOS_APP_STORE_URL=
