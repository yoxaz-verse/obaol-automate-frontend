PORT=3000
NEXT_PUBLIC_API_BASE_URL=/api/v1/web

# Developer Mode API host (obaol-api)
# Production:
NEXT_PUBLIC_OBAOL_API_BASE_URL=https://api.obaol.com
NEXT_PUBLIC_WINDOWS_DESKTOP_URL=https://github.com/yoxaz-verse/obaol-automate-frontend/releases/latest/download/OBAOL-Supreme-Windows-x64.exe
NEXT_PUBLIC_MACOS_DESKTOP_URL=https://github.com/yoxaz-verse/obaol-automate-frontend/releases/latest/download/OBAOL-Supreme-macOS-Universal.dmg
